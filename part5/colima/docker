#!/bin/sh
set -eu
[ "$#" -ge 3 ] && [ "$1" = --host ] && [ "$2" = "unix://$HOME/.docker/run/docker.sock" ] || exit 64
shift 2
[ -S "$HOME/.colima/part5-repro/docker.sock" ] || { echo 'Isolated Colima part5-repro socket not found' >&2; exit 1; }
exec /opt/homebrew/bin/docker --host "unix://$HOME/.colima/part5-repro/docker.sock" "$@"
